{
    "name": "dbseller/phppimaco",
    "description": "Lib para gera\u00e7\u00e3o de Etiquetas PIMACO",
    "keywords": [
        "PIMACO",
        "etiquetas",
        "tags",
        "hang tags"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Diogo Bemfica",
            "email": "diogo.fragabemfica@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Proner\\PhpPimaco\\": "src/"
        }
    },
    "require": {
        "php": "^7.4 || ^8.0 || ^8.1 || ^8.2 || ^8.3 || ^8.4 || ^8.5",
        "ext-json": "*",
        "mpdf/mpdf": "^8.0",
        "endroid/qr-code": "^2.5",
        "picqer/php-barcode-generator": "^0.4"
    },
    "autoload-dev": {
        "psr-4": {
            "Proner\\PhpPimacoTest\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^6.5",
        "squizlabs/php_codesniffer": "^3.2"
    },
    "replace": {
        "dbemfica/phppimaco": "self.version",
        "proner/phppimaco": "self.version"
    },
    "version": "1.4.6"
}
